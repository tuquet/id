# ==============================================================================
# CENTRAL ID SSOT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Architecture: Single Source of Truth for Identity, RBAC & Multi-Tenant Licensing
# ==============================================================================

# ------------------------------------------------------------------------------
# API Gateway & External Endpoints
# ------------------------------------------------------------------------------
# Development: http://127.0.0.1:55321
# Production:  https://id.tuquet.com
API_EXTERNAL_URL=http://127.0.0.1:55321

# Default Web App Redirect
# Development: http://localhost:8000
# Production:  https://store.tuquet.com
SITE_URL=http://localhost:8000

# Permitted Auth Redirect Origins (CORS & OAuth)
# Development: http://localhost:8000,http://localhost:5173,http://localhost:5666
# Production:  https://store.tuquet.com,https://console.tuquet.com,https://tuquet.com
ADDITIONAL_REDIRECT_URLS=http://localhost:8000,http://localhost:5173,http://localhost:5666

# ------------------------------------------------------------------------------
# Database Connection (PostgreSQL Engine)
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55322
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Cross-Subdomain SSO Cookie Scope
# ------------------------------------------------------------------------------
# Development: leave empty or localhost
# Production:  .tuquet.com
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# JWT & Token Settings (Asymmetric ES256 & GoTrue Engine)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Supabase Auth External OAuth Secrets (Optional)
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
