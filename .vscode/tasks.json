{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DB: Reset Local Database (Default)",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/reset_database.mjs",
        "--local"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "DB: Reset Cloud Database (Supabase Cloud)",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/reset_database.mjs",
        "--cloud"
      ],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
